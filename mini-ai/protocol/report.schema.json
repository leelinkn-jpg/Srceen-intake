{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["reportId", "domain", "periodType", "periodStart", "periodEnd", "generatedAt", "dataCutoff", "title", "summary", "severity", "sources", "missingData", "domainSections", "suggestedActions", "status", "revision", "schemaVersion", "markdownSha256"],
  "properties": {
    "reportId": {"type": "string", "pattern": "^[a-z]+-(daily|weekly|monthly)-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "domain": {"enum": ["overall"]},
    "periodType": {"enum": ["daily", "weekly", "monthly"]},
    "periodStart": {"type": "string"},
    "periodEnd": {"type": "string"},
    "generatedAt": {"type": "integer", "minimum": 1000000000000},
    "dataCutoff": {"type": "string"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "severity": {"enum": ["normal", "attention", "urgent"]},
    "sources": {"type": "array", "items": {"type": "object", "required": ["path", "modifiedAt", "sha256"]}},
    "missingData": {"type": "array", "items": {"type": "string"}},
    "domainSections": {"type": "array", "items": {"type": "object", "required": ["domain", "title", "summary", "content", "severity"]}},
    "suggestedActions": {"type": "array", "items": {"type": "object", "required": ["id", "title", "reason", "domain"]}},
    "status": {"const": "complete"},
    "revision": {"type": "integer", "minimum": 1},
    "schemaVersion": {"const": 1},
    "markdownSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
